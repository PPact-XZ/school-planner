// Deny-all Firestore security rules (DEPLOYMENT.md step 1.3).
//
// The Flask server talks to Firestore exclusively through the Admin SDK,
// which bypasses these rules entirely — the client (browser) is never
// granted any direct Firestore access, so deny-all is correct, not a
// placeholder to fill in later.
//
// This file is NOT wired to `firebase deploy` (no firebase.json in this
// repo) — it exists so the rules text is versioned somewhere instead of
// living only inside the Firebase console. Paste this exact text into
// Firestore → Rules for BOTH the dev and prod projects by hand, and update
// this file first if it ever needs to change.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
